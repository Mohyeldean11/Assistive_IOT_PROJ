# Raspberry Pi agent - Python 3.11 only
DEVICE_ID=rpi-01
CAREAGENT_URL=http://192.168.1.100:5000/api/readings
DEVICE_API_KEY=replace-with-the-same-key-used-by-webapp
UPLOAD_INTERVAL_SECONDS=120
SENSOR_READ_INTERVAL_SECONDS=5.0
ANALYSIS_INTERVAL_SECONDS=1.0
EMERGENCY_UPLOAD_COOLDOWN_SECONDS=60
REQUEST_TIMEOUT_SECONDS=12

# Logitech C930/C930e
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_WARMUP_FRAMES=12
POSE_LANDMARKER_MODEL=models/pose_landmarker_lite.task
POSE_CLASSIFIER_MODEL=models/pose_classifier.joblib
# Optional compatibility with the model trained by your original project.
LEGACY_POSE_CLASSIFIER_MODEL=pose_model.pkl
MIN_POSE_DETECTION_CONFIDENCE=0.50
MIN_POSE_PRESENCE_CONFIDENCE=0.50
MIN_TRACKING_CONFIDENCE=0.50
MIN_LANDMARK_VISIBILITY=0.40
MIN_POSE_QUALITY=0.35
CLASSIFIER_MIN_CONFIDENCE=0.60
FLOOR_Y_NORMALIZED=0

# Start with simulation while wiring the hardware sensors.
SIMULATE_SENSORS=true

# Optional local Ollama summary only. It cannot change pose/risk/emergency decisions.
ENABLE_LOCAL_LLM=false
OLLAMA_MODEL=llama3.2:3b
SAVE_DEBUG_FRAMES=false
LOG_LEVEL=INFO

# Snapshot upload: one JPEG is sent with each periodic/emergency reading.
ENABLE_SNAPSHOT_UPLOAD=true
SNAPSHOT_JPEG_QUALITY=70
SNAPSHOT_MAX_WIDTH=960

# Pose troubleshooting
SAVE_POSE_DEBUG_LOG=true
SAVE_DEBUG_FRAMES=false
